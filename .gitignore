# 依赖
/node_modules/

# 环境变量与密钥（绝不提交）
# 覆盖 .env / .env.local / .env.production / .env.*.local 等
.env
.env.*
workdirs.json
# 统一配置文件：与 .env 同等敏感（AUTH_TOKEN / VAPID 私钥 / ntfy token 都在里面），
# 而本仓是 public repo —— 漏进去等于把你的入口密钥推上公网。
# tests/unit/config-file.test.mjs 有一条断言锁住这行，别删。
ccm.config.json
ccm.config.*.json
# writeOwnerOnlyFile 的原子写临时文件（${path}.${pid}.${ts}.${rand}.tmp）——
# 进程在 open 与 rename 之间被 SIGKILL 时会残留，内容是完整的配置含 AUTH_TOKEN。
# .env 靠 .env.* 天然盖住，新文件名不在那条规则的覆盖面内。
ccm.config.json.*

# 运行时状态（ADR-005：会话元数据，本地生成）
/data/

# 其他 AI 编程工具在仓库根落的瞬时运行文件（如 Codex 的 chat RPC 管道）。
# 不 ignore 的话，它存在的瞬间会被 inventory 扫成「未分类文件」，随机打红 check 与单测。
.codex-chat-rpc.jsonl

# 上传附件落盘区（E17/ADR-013：本仓库被当 WORK_DIR 测试时会出现于此）
.ccm-uploads/

# Claude Code 会话产物（plan、skill 历史等，非项目资产）
# ★ 写成 /.claude/* 而不是 /.claude/：git 对【被排除的目录】不再往里看，下面那条 ! 例外就永远不生效
# （"It is not possible to re-include a file if a parent directory of that file is excluded"）。
# 排除目录内容、而非目录本身，例外才有机会命中。
/.claude/*
# 例外：settings.json 是项目级安全配置（PreToolUse 钩子拦破坏性命令），必须入库——
# 它若只存在于某一个 worktree，其余 worktree（含生产 server 所在的主树）就毫无防护。
# 入库后 git 会把它带到每个 worktree 与每次 clone。settings.local.json 仍不入库（个人/凭据）。
!/.claude/settings.json

# 历史遗留守卫：常驻 worktree 现已改为仓库外的平级兄弟目录（../claude-chat-mobile-<分支名>，
# 见 CLAUDE.md 分支纪律），本目录不再使用。留着以防日后有人在仓内建 worktree。
/.worktrees/

# 日志（*.log 文件 + 仓内 logs 目录/文件，防非 .log 后缀落盘被误加）
*.log
npm-debug.log*
/logs
/logs/**

# 系统/编辑器
.DS_Store
.vscode/
.idea/
.qoder/

.reasonix
.codegraph
reasonix.toml

# 测试/E2E 视觉回归测试临时截图
/public/test-snapshots/
/playwright-report/
/playwright-report-shard*/
/test-results/
/test-results-shard*/

.github/copilot-instructions.md
.codex/config.toml
.bug-hunter/
.agents/
.codex/

# tests/gates/mutate.js 运行期的源文件备份（崩溃时靠它还原）。
# 必须忽略：否则会被 git ls-files --others 扫到，污染 repo-inventory / doc 一致性等按文件清单工作的门禁。
*.mutate-backup

# scripts/upstream-watch.js 产出的 issue 正文，workflow 拿它当 --body-file 用完即弃。
# 同上：不忽略会被按文件清单工作的门禁扫到。
upstream-issue.md

# 菜单栏 app 的编译产物：烘着绝对路径且与 CPU 架构绑定，换机器就不对（npm run app:build 重建）
desktop/build/

# 讨论中的文稿，未进产品文档。不入库：否则会被 inventory 扫成未分类文件。
/draft/