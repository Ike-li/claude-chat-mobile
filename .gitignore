# 依赖
/node_modules/

# 环境变量与密钥（绝不提交）
# 覆盖 .env / .env.local / .env.production / .env.*.local 等；仅放行模板 .env.example
.env
.env.*
!.env.example
workdirs.json

# 运行时状态（ADR-005：会话元数据，本地生成）
/data/

# 上传附件落盘区（E17/ADR-013：本仓库被当 WORK_DIR 测试时会出现于此）
.ccm-uploads/

# Claude Code 会话产物（plan、skill 历史等，非项目资产）
/.claude/

# 历史遗留守卫：常驻 worktree 现已改为仓库外的平级兄弟目录（../claude-chat-mobile-<分支名>，
# 见 CLAUDE.md 分支纪律），本目录不再使用。留着以防日后有人在仓内建 worktree。
/.worktrees/

# 日志（*.log 文件 + 仓内 logs 目录/文件，防非 .log 后缀落盘被误加）
*.log
npm-debug.log*
/logs
/logs/**

# 系统/编辑器
.DS_Store
.vscode/
.idea/
.qoder/

.reasonix
.codegraph
reasonix.toml

# 测试/E2E 视觉回归测试临时截图
/public/test-snapshots/
/playwright-report/
/playwright-report-shard*/
/test-results/
/test-results-shard*/

.github/copilot-instructions.md
.codex/config.toml
.bug-hunter/
.agents/
.codex/

# scripts/mutate.js 运行期的源文件备份（崩溃时靠它还原）。
# 必须忽略：否则会被 git ls-files --others 扫到，污染 repo-inventory / doc 一致性等按文件清单工作的门禁。
*.mutate-backup

# scripts/upstream-watch.js 产出的 issue 正文，workflow 拿它当 --body-file 用完即弃。
# 同上：不忽略会被按文件清单工作的门禁扫到。
upstream-issue.md
