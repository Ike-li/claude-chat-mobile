  "cards": [
    {
      "dot": "cyan",
      "title": "Web 驾驶：可写的那条路",
      "items": [
        "手机事件按 instanceId 路由到对应 AgentSession",
        "SDK streaming input 驱动本机 CLI，在授权 cwd 工作",
        "出向统一封装成 agent:event 信封，共 27 种 type"
      ]
    },
    {
      "dot": "emerald",
      "title": "CLI 驾驶：只读镜像",
      "items": [
        "终端进程不经过 SDK，server 不接管它的 stdin",
        "磁盘 transcript 是真相源，hooks 只是加速触发器",
        "未落盘的 thinking 与工具输出暂时不可见"
      ]
    },
    {
      "dot": "rose",
      "title": "硬边界",
      "items": [
        "AUTH_TOKEN 是启动前提，没有它 server 起不来",
        "Cloudflare 非必需，同 WiFi 可直连本机 server",
        "同一时刻只允许一个驾驶员写入同一会话"
      ]
    }
  ]
