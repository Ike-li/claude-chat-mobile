  "cards": [
    {
      "dot": "cyan",
      "title": "为什么去重 ID 登记得这么晚",
      "items": [
        "校验失败就登记，重发会命中去重被当成功删除 pending",
        "结果是消息永久丢失——「假成功丢消息」的根因",
        "只有 send 已 resolve 才 commitProcessed"
      ]
    },
    {
      "dot": "amber",
      "title": "三种负 ack 各有含义",
      "items": [
        "permanent：内容非法，重发必再失败",
        "retryable：实例被弃用或窄竞态，保留 pending",
        "stale：会话已关闭，刷新拿新 instanceId 再发"
      ]
    },
    {
      "dot": "rose",
      "title": "陈旧上下文守卫",
      "items": [
        "SDK 子进程只在 resume 那一刻读过磁盘",
        "终端此后写的轮次它内存里没有，直接发会分叉",
        "忙碌中禁止置换：会 kill 在途 canUseTool"
      ]
    }
  ]
}