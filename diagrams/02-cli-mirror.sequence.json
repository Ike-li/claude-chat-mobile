  "cards": [
    {
      "dot": "rose",
      "title": "锁为什么只认终端写的尾部",
      "items": [
        "transcript 逐条自报写入方：CLI 写 cli，本项目写 sdk-ts",
        "己方 SDK 留下的未完结尾部撑不住锁",
        "否则 Web 等一条审批就自锁，点不到批准"
      ]
    },
    {
      "dot": "emerald",
      "title": "hooks 只是加速触发器",
      "items": [
        "把回合结束的发现时间缩短到文件事件",
        "未安装则完整回落纯轮询，功能不缺失",
        "磁盘 transcript 始终是真相源"
      ]
    },
    {
      "dot": "amber",
      "title": "只读镜像的硬限制",
      "items": [
        "只看得到已落盘内容，不是实时 stdout",
        "不能向终端进程输入，也无法附着 stdin",
        "纯终端等待的会话不进「需要你」聚合"
