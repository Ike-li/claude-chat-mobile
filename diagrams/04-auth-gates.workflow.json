  "cards": [
    {
      "dot": "rose",
      "title": "这些边界互不替代",
      "items": [
        "AUTH_TOKEN 证明持有实例密钥，不代表设备已获准",
        "CF Access 可选：开着替代设备门（JWT 失败不回落设备），不替代 token",
        "WORKDIRS 限定路径，不决定工具是否自动获批",
        "canUseTool 只管 Agent 自主行为"
      ]
    },
    {
      "dot": "amber",
      "title": "限速措辞按来源分档",
      "items": [
        "describeRateLimitSource 分本机 / 局域网 / 公网三档改措辞与判色",
        "本机来源绝不说成「有人在暴力尝试」——输错一次密码不是攻击",
        "退避短锁与阈值长锁共用一个 verdict 就是在说反话"
      ]
    },
    {
      "dot": "cyan",
      "title": "fail-closed 的两个例外",
      "items": [
        "trusted-devices.json 瞬时读失败保留 last-good，不是拒绝",
        "鉴权通过后 handler 抛 500 不得计入限速",
        "新设备通知正文不含设备 ID 与 IP，并按 5 分钟节流"
      ]
    }
  ]
