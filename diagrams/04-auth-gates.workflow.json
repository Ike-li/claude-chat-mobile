  "cards": [
    {
      "dot": "rose",
      "title": "六层收窄是分类学，不是请求路径",
      "items": [
        "文档那六层讲的是「每层管什么」，不是「哪些层会被执行」",
        "局域网路径没有 IdP 这一层；Access 已验或 loopback 直连都跳过设备门",
        "两条路在工作区范围门汇合，之后共用权限档与 canUseTool"
      ]
    },
    {
      "dot": "amber",
      "title": "两条路各自的凭证",
      "items": [
        "Access 未启用时 isPublicHost 恒 false，全部走 AUTH_TOKEN",
        "公网 Host 上的凭证是 JWT，失败即 401、绝不回落 token",
        "AUTH_TOKEN 仍是启动前提，只是请求级不出现在公网这条路上"
      ]
    },
    {
      "dot": "cyan",
      "title": "限速与两处刻意的不 fail-closed",
      "items": [
        "限速按 IP 桶（IPv6 按 /64），措辞分本机/局域网/公网三档",
        "trusted-devices.json 瞬时读失败保留 last-good",
        "鉴权通过后 handler 抛 500 不计入限速；空 Host 不当本机"
      ]
    }
  ]
