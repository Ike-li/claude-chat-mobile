  "cards": [
    {
      "dot": "cyan",
      "title": "判据是可见性，不是重要性",
      "items": [
        "审批、提问、后台任务完成一律无条件推",
        "这三类都意味着有人在等一个动作，而用户可能锁屏或在别的 app",
        "result 与网关静默告警按前台抑制；审批/提问/后台完成无条件推"
      ]
    },
    {
      "dot": "rose",
      "title": "前台判据不是 socket 连着",
      "items": [
        "手机切后台时 socket 常常还活着",
        "拿连接状态当判据会让用户收不到本该收到的完成通知",
        "真判据是客户端主动上报的 client:presence"
      ]
    },
    {
      "dot": "amber",
      "title": "正文默认最小化",
      "items": [
        "审批通知只保留工具名，不含 input 命令与参数正文",
        "提问通知不含问题正文，用固定引导文案",
        "开启预览后 web-push 改发 previewBody（ntfy 始终最小化）",
        "新设备通知不含设备 ID 与 IP，并按 5 分钟节流"
      ]
    }
  ]
