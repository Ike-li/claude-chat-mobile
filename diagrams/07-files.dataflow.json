  "cards": [
    {
      "dot": "cyan",
      "title": "附件已搬出用户项目",
      "items": [
        "新家是数据目录下的 uploads/<bucket>/",
        "工作区里的 .ccm-uploads 只读回落，永不再写",
        "ensureUploadsRoot 必须跑在 SDK spawn 之前",
        "--add-dir 是启动时快照，目录那一刻不存在就被 CLI 丢弃"
      ]
    },
    {
      "dot": "rose",
      "title": "范围门之外还有两道",
      "items": [
        "symlink 判据是「父目录用户可写」，不是 realpath 命中",
        "用户点保存属于直接写入，走独立的大小、哈希与审计防线",
        "浏览/git 有条数与字节上限，搜索另有深度上限"
      ]
    },
    {
      "dot": "amber",
      "title": "git 变更是读路径的一支",
      "items": [
        "porcelain -z 解析，相对路径先过 assertSafeRelPath",
        "条目数与 diff 字节都有上限，不整棵仓库读进内存",
        "写入侧的审计记录见运维与可观测那张图"
      ]
    }
  ]
