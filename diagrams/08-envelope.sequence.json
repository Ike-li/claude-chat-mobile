  "cards": [
    {
      "dot": "cyan",
      "title": "信封里为什么有两个 id",
      "items": [
        "sessionId 是 CLI 会话身份，instanceId 是 Web 进程实例",
        "分开才不会把同一会话与它的多个实例混淆",
        "epoch 标识服务端世代，变化即重置去重基线"
      ]
    },
    {
      "dot": "amber",
      "title": "环形缓冲不是永久历史",
      "items": [
        "缓冲有界，缺口超出或重启就回退 session:history",
        "历史从 transcript 重建稳定消息，不是重放缓冲",
        "高频瞬态状态不会全部进入永久历史"
      ]
    },
    {
      "dot": "rose",
      "title": "事件契约是硬闸",
      "items": [
        "后端发送方与 mock server 双向校验 type 闭合集",
        "前端 handle + outOfBand 键并集须精确等于 27 种",
        "少一个＝静默丢弃，多一个＝死键"
      ]
    }
  ]
}