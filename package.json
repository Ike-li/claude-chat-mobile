{
  "name": "claude-chat-mobile",
  "version": "1.6.1",
  "description": "Mobile chat UI that bridges your local claude CLI to your phone — terminal-equivalent agent access (resume, streaming output, on-device tool approvals).",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Ike-li (https://github.com/Ike-li)",
  "homepage": "https://github.com/Ike-li/claude-chat-mobile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ike-li/claude-chat-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/Ike-li/claude-chat-mobile/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "agent-sdk",
    "mobile",
    "pwa",
    "websocket",
    "self-hosted",
    "remote-access",
    "chat-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "verifiedWith": {
    "claudeCli": "2.1.245"
  },
  "scripts": {
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "uninstall": "node scripts/uninstall.js",
    "config": "node scripts/config.js",
    "config:check": "node scripts/config.js check",
    "config:migrate": "node scripts/config.js migrate",
    "statusline:status": "node scripts/statusline-bridge-setup.js status",
    "statusline:install": "node scripts/statusline-bridge-setup.js install",
    "statusline:uninstall": "node scripts/statusline-bridge-setup.js uninstall",
    "hooks:status": "node scripts/hooks-bridge-setup.js status",
    "hooks:install": "node scripts/hooks-bridge-setup.js install",
    "hooks:uninstall": "node scripts/hooks-bridge-setup.js uninstall",
    "hooks:verify": "node scripts/hooks-bridge-setup.js verify",
    "service:status": "node scripts/service.js status",
    "service:install": "node scripts/service.js install",
    "service:adopt": "node scripts/service.js adopt",
    "service:uninstall": "node scripts/service.js uninstall",
    "service:restart": "node scripts/service.js restart",
    "service:logs": "node scripts/service.js logs",
    "service:health": "node scripts/service.js health",
    "app:build": "node scripts/app-build.js",
    "app:install": "node scripts/app-build.js --install",
    "app:test": "node scripts/app-build.js --test-only",
    "dev": "node --watch server.js",
    "check": "eslint . && node scripts/check-import-boundaries.js && node scripts/contract-check.js && node scripts/doc-consistency.js && node scripts/check-n1-assumptions.js && node scripts/i18n-check.js && node scripts/check-destructive-deletes.js && node scripts/check-visual-mock-registry.js && node scripts/check-playwright-forbidden-patterns.js && node scripts/app-build.js --test-only && npm run inventory:check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "inventory:update": "node scripts/repo-inventory.js --write",
    "inventory:check": "node scripts/repo-inventory.js --check",
    "test": "node --import ./tests/setup/preload-env.mjs --test --test-force-exit tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --import ./tests/setup/preload-env.mjs --test tests/unit/*.test.mjs",
    "test:integration": "node --import ./tests/setup/preload-env.mjs --test --test-force-exit tests/integration/*.test.mjs",
    "test:coverage": "node --import ./tests/setup/preload-env.mjs --experimental-test-coverage --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "node scripts/test-e2e-parallel.js",
    "test:visual": "npm run test:e2e",
    "test:playwright": "npm run test:e2e",
    "test:playwright:p0": "playwright test tests/e2e/p0",
    "test:smoke": "node tests/smoke/runner.js",
    "contract:check": "node scripts/contract-check.js",
    "watch:upstream": "node scripts/upstream-watch.js",
    "mutate": "node scripts/mutate.js",
    "docker:build": "docker compose -f docker-compose.test.yml build",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm test sh -lc \"npm run test:unit && npm run test:integration\"",
    "test:docker:unit": "docker compose -f docker-compose.test.yml run --rm test npm run test:unit",
    "test:docker:e2e": "docker compose -f docker-compose.test.yml run --rm test npm run test:e2e",
    "test:docker:sh": "docker compose -f docker-compose.test.yml run --rm test bash",
    "mutate:docker": "docker compose -f docker-compose.test.yml run --rm test npm run mutate --"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "compression": "^1.8.1",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "jose": "^6.2.3",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "socket.io-client": "^4.8.3"
  }
}
