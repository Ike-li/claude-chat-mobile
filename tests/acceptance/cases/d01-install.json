      "ex": "生成 ccm.config.json，权限 0600，含随机 AUTH_TOKEN；WORKDIRS 为空，不回落 $HOME",
      "b": "GS§3 非交互模式；HR§1",
      "env": [
        "T"
      ],
      "p": "P1",
      "m": "场景",
      "j": [
        "J1"
      ],
      "n": "R0：newuser 车道带 --work-dir 的分支已跑通，本条补不给的分支",
      "tier": null,
      "check": null
