# playground/runtime.env —— 提交进 git。token 不是秘密，是夹具身份。
# 禁止 CI=true：app 要像新用户，不要走测试门控。
HOME=/home/ccm-test
AUTH_TOKEN=playground-local-not-a-secret
CCM_DATA_DIR=/home/ccm-test/ccm-data
WORK_DIR=/home/ccm-test/workspace
WORK_DIRS=/home/ccm-test/workspace
WORK_DIRS_FILE=
CLAUDE_BIN=/app/tests/fixtures/fake-claude.sh
BIND_MODE=lan
BIND_HOST=
PORT=3000
ACCESS_PROFILE=lan
DEV_MODE=
ASSET_HOT_RELOAD=1
LOG_TERMINAL=off
CLI_HOOKS_BRIDGE=off
CLI_STATUSLINE_BRIDGE=off
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
CF_ACCESS_HOSTNAME=
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
PUBLIC_URL=
CCM_HOOKS_ORIGIN=
CCM_STATUSLINE_ORIGIN=
CCM_TEST_PRESERVE_EMPTY_ENV=1
RUN_CLAUDE_INTEGRATION=
